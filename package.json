{
  "name": "table-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 5341 --strictPort --open",
    "dev": "vite --port 5341 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build && node scripts/spa-fallback.mjs",
    "build:pages": "cross-env BASE_PATH=/table-desk/ npm run build",
    "preview": "vite preview --port 5341 --strictPort",
    "test": "npm run build:pages && playwright test --project=e2e",
    "screenshots": "npm run build:pages && playwright test --project=shots"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "msw": "^3.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
